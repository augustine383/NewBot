# ─────────────────────────────────────────────────────────────────
#  WhatsApp Bot — Environment Variables
#  On Render: add these in Dashboard → NewBot → Environment
# ─────────────────────────────────────────────────────────────────

# ── Bot Identity ──────────────────────────────────────────────────
BUSINESS_NAME="Your Business Name"
ADMIN_PHONE="233XXXXXXXXX"
ADMIN_SECRET="changeme123"

# ── Neon PostgreSQL (REQUIRED — no other DB supported) ────────────
DATABASE_URL="postgresql://neondb_owner:YOURPASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Grok / xAI (REQUIRED for AI replies — no other LLM supported) ─
# Get your key at: https://console.x.ai
GROK_API_KEY="xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROK_MODEL="grok-3"

# ── Admin Dashboard ───────────────────────────────────────────────
ADMIN_PORT=3001
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# ── Session ───────────────────────────────────────────────────────
SESSION_NAME="whatsapp-bot"
SESSION_FOLDER="./tokens"

# ── Drip Timing ───────────────────────────────────────────────────
DRIP_DAY1_HOURS=24
DRIP_DAY2_HOURS=48
DRIP_DAY3_HOURS=72

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=10

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL="info"
LOG_FILE="./logs/bot.log"

# ── Render Auto-set (DO NOT touch) ───────────────────────────────
# PORT
# RENDER
# RENDER_EXTERNAL_HOSTNAME
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
