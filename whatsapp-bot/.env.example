# ─────────────────────────────────────────────
#  WhatsApp Bot — Environment Configuration
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Bot Identity
BUSINESS_NAME="Your Business Name"
ADMIN_PHONE="233XXXXXXXXX"        # Admin WhatsApp number (no + or spaces)
ADMIN_SECRET="changeme123"        # Secret for admin commands via WhatsApp

# ── Neon PostgreSQL Database ──────────────────
# Get this from your Neon dashboard → Connection string
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Grok AI (xAI) ─────────────────────────────
# Get your API key at: https://console.x.ai/
GROK_API_KEY=""
# Available models: grok-3, grok-3-fast, grok-3-mini, grok-2
GROK_MODEL="grok-3"

# Admin Web Dashboard
ADMIN_PORT=3001
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"         # Change this!

# Bot Session
SESSION_NAME="whatsapp-bot"
SESSION_FOLDER="./tokens"

# Drip Campaign Timing (hours after signup)
DRIP_DAY1_HOURS=24
DRIP_DAY2_HOURS=48
DRIP_DAY3_HOURS=72

# Rate Limiting (max messages per user per hour)
RATE_LIMIT_PER_HOUR=10

# Logging
LOG_LEVEL="info"                  # debug | info | warn | error
LOG_FILE="./logs/bot.log"
